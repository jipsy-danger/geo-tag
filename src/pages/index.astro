<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>GPS Map Camera</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
<style>
*{box-sizing:border-box}html,body{margin:0;background:#080b0f;color:#f4f5f6;font-family:Arial,Helvetica,sans-serif}body{min-height:100vh}.shell{max-width:1260px;margin:auto;padding:28px 22px 55px}.top{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:18px}.kicker{font-size:11px;letter-spacing:.18em;font-weight:700;color:#87929d}.top h1{font-size:38px;margin:7px 0 8px;letter-spacing:-.04em}.top p{margin:0;color:#9ca7b2;font-size:14px}.live{border:1px solid #34404b;border-radius:99px;padding:7px 11px;font-size:10px;color:#9ba6b0}.layout{display:grid;grid-template-columns:350px 1fr;gap:18px}.card{background:#10151b;border:1px solid #28313a;border-radius:18px;box-shadow:0 25px 70px #0008}.controls{padding:16px}.block{padding-bottom:15px;margin-bottom:15px;border-bottom:1px solid #252d35}.block h2{font-size:10px;margin:0 0 9px;letter-spacing:.06em}.upload{display:block;border:1px dashed #4b5662;border-radius:12px;background:#0b0f14;padding:18px;text-align:center;cursor:pointer}.upload input{display:none}.upload b{display:block;font-size:13px;margin-bottom:4px}.upload span{font-size:10px;color:#7e8994}.cameraBtns{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:8px}.btn{border:1px solid #37424e;background:#151b21;color:#f2f4f5;border-radius:9px;padding:10px 9px;font-size:11px;font-weight:700;cursor:pointer}.btn.primary{background:#f4f5f6;color:#0b0e12}.btn:disabled{opacity:.35;cursor:not-allowed}#map{height:285px;border-radius:12px;overflow:hidden;border:1px solid #303a44}.coords{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:8px}.field{margin-top:8px}.field label{display:block;color:#7f8a95;font-size:9px;margin-bottom:5px}.field input{width:100%;border:1px solid #303a44;background:#090d12;color:#f2f4f5;border-radius:8px;padding:9px;font-size:11px;outline:none}.status{font-size:10px;color:#75818c;min-height:14px;margin-top:7px}.hint{font-size:9px;color:#68747f;line-height:1.5}.preview{padding:12px}.previewHead{height:34px;display:flex;justify-content:space-between;align-items:center}.previewHead b{font-size:12px}.previewHead small{display:block;color:#68747f;font-size:9px;margin-top:2px}.stage{position:relative;background:#020304;border-radius:11px;overflow:hidden;min-height:690px;display:flex;align-items:center;justify-content:center}.media{position:relative;max-width:100%;max-height:690px;overflow:hidden}.media video,.media img{display:block;max-width:100%;max-height:690px;width:auto;height:auto;object-fit:contain}.media video{background:#000}.stamp{position:absolute;left:1.75%;width:84.4%;height:19%;bottom:13.9%;top:auto;display:flex;align-items:stretch;pointer-events:none;filter:drop-shadow(0 3px 7px #0008)}.stampMap{width:16.9%;height:100%;flex:0 0 16.9%;min-width:0;overflow:hidden;background:#3b4939;position:relative}.stampMap img{width:100%;height:100%;object-fit:cover;display:block}.pin{position:absolute;left:50%;top:50%;width:24px;height:24px;background:#ed302d;border:2px solid #fff;border-radius:50% 50% 50% 0;transform:translate(-50%,-65%) rotate(-45deg);box-shadow:0 2px 4px #0009}.pin:after{content:"";position:absolute;width:7px;height:7px;background:#fff;border-radius:50%;left:6px;top:6px}.mapCredit{position:absolute;bottom:3px;left:12px;font-size:31px;font-weight:400;color:#fff;line-height:1;text-shadow:0 1px 3px #000;letter-spacing:-1px}.stampInfo{height:100%;flex:1;background:rgba(25,30,36,.78);position:relative;padding:2.1% 1.35% 1.5%;min-width:0}.title{font-size:clamp(18px,1.88vw,30px);font-weight:400;line-height:1.08;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding-right:24%}.addr{font-size:clamp(10px,1.22vw,20px);line-height:1.15;margin-top:7px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding-right:1%}.coord{font-size:clamp(10px,1.13vw,18px);line-height:1.28;margin-top:5px}.time{font-size:clamp(10px,1.13vw,18px);line-height:1.28;margin-top:5px}.badge{position:absolute;right:0;top:-26%;height:31%;max-height:57px;min-height:38px;display:block}.badgeLogo{position:absolute;right:0;top:-48%;width:min(15%,220px);height:auto;max-height:none;display:block}.watermark{display:none}.empty{color:#697580;font-size:11px;text-align:center;padding:90px}.captureRow{display:flex;gap:8px;justify-content:center;position:absolute;bottom:18px;left:0;right:0}.capture{width:58px;height:58px;border-radius:50%;border:4px solid #fff;background:#fff8;box-shadow:0 2px 10px #0009;cursor:pointer}.capture span{display:block;width:43px;height:43px;background:#fff;border-radius:50%;margin:auto}.mode{position:absolute;top:14px;left:14px;background:#0009;border:1px solid #fff3;color:#fff;padding:6px 9px;border-radius:99px;font-size:9px}.leaflet-control-attribution{font-size:7px!important}
@media(max-width:900px){.layout{grid-template-columns:1fr}.stage{min-height:450px}.top{align-items:flex-start;gap:10px;flex-direction:column}.stamp{left:2%;width:96%;height:20%;bottom:8%}.stampMap{width:17%;flex-basis:17%}.mapCredit{font-size:16px;left:5px}.title{font-size:clamp(12px,3vw,22px)}.addr,.coord,.time{font-size:clamp(7px,2vw,13px)}.badgeLogo{width:min(18%,180px);top:-45%}}
</style>
</head>
<body>
<div class="shell">
<header class="top"><div><div class="kicker">GPS MAP CAMERA</div><h1>Real-time geotag camera</h1><p>Live camera + live GPS + real satellite map + automatic location data.</p></div><div class="live" id="gpsState">GPS waiting</div></header>
<div class="layout">
<aside class="card controls">
<div class="block"><h2>01 · CAMERA</h2><div class="cameraBtns"><button class="btn primary" id="startCamera">Open camera</button><button class="btn" id="stopCamera">Stop camera</button></div><label class="upload"><input id="photo" type="file" accept="image/*"/><b>Upload existing photo</b><span id="fileName">Use camera or choose a local image</span></label></div>
<div class="block"><h2>02 · LIVE LOCATION</h2><div id="map"></div><div class="coords"><div class="field"><label>Latitude</label><input id="lat" type="number" step="0.000001" value="23.978530"></div><div class="field"><label>Longitude</label><input id="lng" type="number" step="0.000001" value="85.359895"></div></div><div class="cameraBtns"><button class="btn" id="gps">Start live GPS</button><button class="btn" id="update">Update map</button></div><div class="status" id="locationStatus">Click map, drag pin, or start GPS.</div></div>
<div class="block"><h2>03 · REAL STAMP DATA</h2><div class="field"><label>Place</label><input id="place" value="Hazaribagh, Jharkhand, India"></div><div class="field"><label>Address</label><input id="address" value="Sri RamaKrishna Sarada Ashrama Teacher's Training College,Hurhuru, Hazaribagh, Jharkhand 825301, India"></div><div class="field"><label>Date & time</label><input id="date" type="datetime-local"></div><div class="field"><label>Timezone</label><input id="zone" value="GMT +05:30"></div><p class="hint">The output layout is scaled from the supplied 1600×1200 reference: lower photo placement, square map, dark panel, exact hierarchy and logo position.</p></div>
<div class="cameraBtns"><button class="btn primary" id="capture">Capture stamped photo</button><button class="btn" id="download" disabled>Download JPEG</button></div>
</aside>
<section class="card preview"><div class="previewHead"><div><b>Live camera preview</b><small id="previewText">Allow camera permission to shoot like a GPS camera.</small></div><div class="live" id="modeText">LIVE</div></div><div class="stage" id="stage"><div class="empty" id="empty">Open camera or upload a photo.<br>GPS data and timestamp will appear on the real image.</div><div class="media" id="media" hidden><video id="video" playsinline autoplay muted></video><img id="photoPreview" alt="" hidden><div class="stamp"><div class="stampMap"><img id="stampMap" alt="Real satellite map"><div class="pin"></div><div class="mapCredit">Google</div></div><div class="stampInfo"><img class="badgeLogo" id="badgeLogo" src="/geo-tag/gps-map-camera-logo.svg" alt="GPS Map Camera"><div class="title" id="stampPlace"></div><div class="addr" id="stampAddress"></div><div class="coord" id="stampLat"></div><div class="coord" id="stampLng"></div><div class="time" id="stampTime"></div></div></div><div class="mode" id="accuracy">NO GPS</div><div class="captureRow"><button class="capture" id="shutter" title="Capture"><span></span></button></div></div></div></section>
</div></div>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<script src="https://cdn.jsdelivr.net/npm/piexifjs@1.0.6/piexif.min.js"></script>
<script>
const $=id=>document.getElementById(id);let stream=null,watch=null,map,marker,source=null,lastMapUrl='',geoBusy=false,logoImage=null;
const lat=$("lat"),lng=$("lng"),place=$("place"),address=$("address"),date=$("date"),zone=$("zone"),video=$("video"),img=$("photoPreview"),media=$("media");
const LOGO_URL='/geo-tag/gps-map-camera-logo.svg';
function now(){const d=new Date();date.value=new Date(d-d.getTimezoneOffset()*60000).toISOString().slice(0,16)}now();
logoImage=new Image();logoImage.crossOrigin='anonymous';logoImage.src=LOGO_URL;
setInterval(()=>{if(!date.matches(':focus'))now();renderStamp()},1000);
map=L.map('map').setView([+lat.value,+lng.value],17);const sat=L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',{maxZoom:19,attribution:'Tiles © Esri'}).addTo(map);const street=L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19,attribution:'© OpenStreetMap'});L.control.layers({'Satellite':sat,'Street':street}).addTo(map);marker=L.marker([+lat.value,+lng.value],{draggable:true}).addTo(map);
function setPoint(a,b){lat.value=a.toFixed(6);lng.value=b.toFixed(6);marker.setLatLng([a,b]);map.setView([a,b],Math.max(16,map.getZoom()));reverse(a,b);refreshMap();renderStamp()}
marker.on('dragend',()=>{const p=marker.getLatLng();setPoint(p.lat,p.lng)});map.on('click',e=>setPoint(e.latlng.lat,e.latlng.lng));
$('update').onclick=()=>{const a=+lat.value,b=+lng.value;if(Number.isFinite(a)&&Number.isFinite(b))setPoint(a,b)};
$('gps').onclick=()=>startGPS();
function startGPS(){if(!navigator.geolocation){$('locationStatus').textContent='Geolocation is not supported.';return}if(watch!==null)navigator.geolocation.clearWatch(watch);$('gpsState').textContent='GPS active';$('locationStatus').textContent='Waiting for high-accuracy GPS…';watch=navigator.geolocation.watchPosition(pos=>{$('gpsState').textContent='GPS ±'+Math.round(pos.coords.accuracy||0)+' m';$('locationStatus').textContent='Live GPS position received.';$('accuracy').textContent=(pos.coords.accuracy?Math.round(pos.coords.accuracy)+' m':'GPS');const a=pos.coords.latitude,b=pos.coords.longitude;lat.value=a.toFixed(6);lng.value=b.toFixed(6);marker.setLatLng([a,b]);map.panTo([a,b],{animate:false});reverse(a,b);refreshMap();renderStamp()},err=>{$('gpsState').textContent='GPS unavailable';$('locationStatus').textContent=err.message},{enableHighAccuracy:true,maximumAge:0,timeout:15000})}
async function reverse(a,b){if(geoBusy)return;geoBusy=true;try{const r=await fetch('https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat='+a+'&lon='+b+'&zoom=18&addressdetails=1');if(r.ok){const d=await r.json();if(d.display_name)address.value=d.display_name;const x=d.address||{},c=x.city||x.town||x.village||x.municipality||x.county||'',s=x.state||'',co=x.country||'';if(c||s||co)place.value=[c,s,co].filter(Boolean).join(', ');$('locationStatus').textContent='Address updated from live coordinates.'}}catch(e){}geoBusy=false;renderStamp()}
function refreshMap(){const a=+lat.value,b=+lng.value;lastMapUrl='https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/export?bbox='+encodeURIComponent(b-.0015)+','+encodeURIComponent(a-.001)+','+encodeURIComponent(b+.0015)+','+encodeURIComponent(a+.001)+'&bboxSR=4326&size=900,900&imageSR=4326&format=jpg&f=image';$('stampMap').src=lastMapUrl}
function stampText(){const d=new Date(date.value||Date.now()),dd=String(d.getDate()).padStart(2,'0'),mm=String(d.getMonth()+1).padStart(2,'0'),yy=String(d.getFullYear()).slice(-2);let h=d.getHours();const ap=h>=12?'PM':'AM';h=h%12||12;return dd+'/'+mm+'/'+yy+' '+String(h).padStart(2,'0')+':'+String(d.getMinutes()).padStart(2,'0')+' '+ap+' '+zone.value}
function renderStamp(){$('stampPlace').textContent=place.value;$('stampAddress').textContent=address.value;$('stampLat').textContent='Lat '+(+lat.value).toFixed(5)+'°';$('stampLng').textContent='Long '+(+lng.value).toFixed(5)+'°';$('stampTime').textContent=stampText()}
async function openCamera(){try{stream=await navigator.mediaDevices.getUserMedia({video:{facingMode:{ideal:'environment'},width:{ideal:1920},height:{ideal:1080}},audio:false});video.srcObject=stream;video.hidden=false;img.hidden=true;media.hidden=false;$('empty').hidden=true;$('previewText').textContent='Camera live — GPS stamp is overlaid in the same lower position as the reference.';startGPS();}catch(e){$('locationStatus').textContent='Camera permission is required: '+e.message}}
function stopCamera(){if(stream){stream.getTracks().forEach(t=>t.stop());stream=null}}
$('startCamera').onclick=openCamera;$('stopCamera').onclick=stopCamera;
$('photo').onchange=e=>{const f=e.target.files?.[0];if(!f)return;$('fileName').textContent=f.name;const r=new FileReader();r.onload=()=>{source=new Image();source.onload=()=>{video.hidden=true;img.hidden=false;img.src=r.result;media.hidden=false;$('empty').hidden=true;$('previewText').textContent='Uploaded photo — GPS stamp positioned like the supplied final image.';renderStamp();refreshMap()};source.src=r.result;img.src=r.result};r.readAsDataURL(f)};
async function captureFrame(){if(!video.videoWidth)return null;const c=document.createElement('canvas');c.width=video.videoWidth;c.height=video.videoHeight;c.getContext('2d').drawImage(video,0,0,c.width,c.height);return await loadImage(c.toDataURL('image/jpeg',.96))}
function loadImage(src){return new Promise((resolve,reject)=>{const i=new Image();i.onload=()=>resolve(i);i.onerror=reject;i.src=src})}
async function mapBitmap(){return await loadImage(lastMapUrl)}
function fit(ctx,text,max,start,min){let s=start;while(s>min){ctx.font=`${s}px Arial`;if(ctx.measureText(text).width<=max)return s;s--}return min}
async function renderOutput(){let base=source;if(stream&&video.videoWidth)base=await captureFrame();if(!base)return null;const W=base.naturalWidth||base.width,H=base.naturalHeight||base.height,c=document.createElement('canvas');c.width=W;c.height=H;const ctx=c.getContext('2d');ctx.imageSmoothingQuality='high';ctx.drawImage(base,0,0,W,H);
const stampW=Math.round(W*.844),stampH=Math.round(H*.19),sx=Math.round(W*.0175),sy=Math.round(H*.671),mapW=stampH,gap=Math.round(W*.0145),infoX=sx+mapW+gap,infoW=stampW-mapW-gap;
let mapImg;try{mapImg=await mapBitmap()}catch(e){mapImg=null}
ctx.save();ctx.shadowColor='rgba(0,0,0,.28)';ctx.shadowBlur=Math.max(5,W*.006);ctx.fillStyle='#111';ctx.fillRect(sx,sy,mapW,stampH);ctx.restore();if(mapImg)ctx.drawImage(mapImg,sx,sy,mapW,stampH);
const px=sx+mapW*.5,py=sy+mapW*.52,pr=Math.max(11,W*.009);ctx.save();ctx.fillStyle='#ed302d';ctx.strokeStyle='#fff';ctx.lineWidth=Math.max(2,W*.0015);ctx.beginPath();ctx.arc(px,py-pr*.25,pr,Math.PI,0);ctx.bezierCurveTo(px+pr,py+pr*.65,px,py+pr*1.65,px,py+pr*1.65);ctx.bezierCurveTo(px,py+pr*1.65,px-pr,py+pr*.65,px-pr,py-pr*.25);ctx.closePath();ctx.fill();ctx.stroke();ctx.fillStyle='#fff';ctx.beginPath();ctx.arc(px,py-pr*.25,pr*.34,0,Math.PI*2);ctx.fill();ctx.restore();
ctx.fillStyle='rgba(25,30,36,.78)';ctx.fillRect(infoX,sy,infoW,stampH);
const pad=Math.round(W*.012),tx=infoX+pad,maxText=infoW-pad*2;let fs=fit(ctx,place.value,maxText*.75,30,16);ctx.font=`${fs}px Arial`;ctx.fillStyle='#fff';ctx.fillText(place.value,tx,sy+Math.round(stampH*.22));
fs=Math.min(20,Math.max(13,Math.round(W*.0122)));ctx.font=`${fs}px Arial`;ctx.fillText(address.value,tx,sy+Math.round(stampH*.36));
fs=Math.min(18,Math.max(13,Math.round(W*.0113)));ctx.font=`${fs}px Arial`;ctx.fillText('Lat '+(+lat.value).toFixed(5)+'°',tx,sy+Math.round(stampH*.53));ctx.fillText('Long '+(+lng.value).toFixed(5)+'°',tx,sy+Math.round(stampH*.69));ctx.fillText(stampText(),tx,sy+Math.round(stampH*.86));
if(logoImage?.complete&&logoImage.naturalWidth){const lw=Math.min(Math.round(W*.14),Math.round(infoW*.20)),lh=lw*logoImage.naturalHeight/logoImage.naturalWidth,lx=infoX+infoW-lw,ly=sy-lh*.52;ctx.drawImage(logoImage,lx,ly,lw,lh)}
return c}
$('capture').onclick=async()=>{const c=await renderOutput();if(!c){$('locationStatus').textContent='Open camera or upload a photo first.';return}source=await loadImage(c.toDataURL('image/jpeg',.96));img.src=source.src;video.hidden=true;img.hidden=false;media.hidden=false;$('empty').hidden=true;$('download').disabled=false;$('previewText').textContent='Captured output — exact lower stamp layout applied.';window.__out=c};
$('shutter').onclick=$('capture').onclick;
$('download').onclick=()=>{if(!window.__out)return;const raw=window.__out.toDataURL('image/jpeg',.96);let out=raw;try{const a=Math.abs(+lat.value),b=Math.abs(+lng.value),d=new Date(date.value||Date.now()),p=n=>String(n).padStart(2,'0'),dms=v=>{const deg=Math.floor(v),m=(v-deg)*60,mi=Math.floor(m),sec=Math.round((m-mi)*60);return [[deg,1],[mi,1],[sec,1]]};const exif={"0th":{"270":place.value+' | '+address.value},"Exif":{"36867":`${d.getFullYear()}:${p(d.getMonth()+1)}:${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}:${p(d.getSeconds())}`},"GPS":{"1":+lat.value>=0?'N':'S',"2":dms(a),"3":+lng.value>=0?'E':'W',"4":dms(b)}};out=piexif.insert(piexif.dump(exif),raw)}catch(e){}const a=document.createElement('a');a.href=out;a.download='gps-map-camera.jpg';a.click()};
[lat,lng,place,address,date,zone].forEach(x=>x.addEventListener('input',()=>{if(x===lat||x===lng){if(Number.isFinite(+lat.value)&&Number.isFinite(+lng.value)){marker.setLatLng([+lat.value,+lng.value]);map.panTo([+lat.value,+lng.value],{animate:false});refreshMap()}}renderStamp()}));renderStamp();refreshMap();
</script>
</body></html>
