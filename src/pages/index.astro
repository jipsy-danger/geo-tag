<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GPS Map Camera</title>
  <meta name="description" content="Create GPS Map Camera style geotagged photos with a real satellite map." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
  <style>
    :root{font-family:Inter,Arial,sans-serif;color:#eef2f5;background:#080a0d}
    *{box-sizing:border-box}
    body{margin:0;min-height:100vh;background:radial-gradient(circle at 80% -10%,#28313b 0,#11161c 38%,#080a0d 72%)}
    main{max-width:1280px;margin:auto;padding:34px 22px 60px}
    .top{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:22px}
    .eyebrow{font-size:11px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:#9aa5b1}
    h1{font-size:40px;line-height:1;margin:8px 0;letter-spacing:-.045em}
    .sub{max-width:760px;margin:0;color:#aab4bf;line-height:1.55;font-size:14px}
    .pill{border:1px solid #303944;color:#9ca7b3;border-radius:999px;padding:7px 10px;font-size:10px;white-space:nowrap}
    .grid{display:grid;grid-template-columns:365px minmax(0,1fr);gap:20px}
    .panel,.preview{border:1px solid #29313a;background:rgba(14,18,23,.93);border-radius:20px;box-shadow:0 24px 70px rgba(0,0,0,.34)}
    .panel{padding:18px}.preview{padding:13px}
    .section{padding-bottom:17px;margin-bottom:17px;border-bottom:1px solid #252c34}
    .section h2{font-size:11px;margin:0 0 10px;color:#d7dde3;letter-spacing:.05em}
    .upload{display:block;border:1px dashed #48535f;background:#0a0e13;border-radius:14px;padding:20px;text-align:center;cursor:pointer;color:#8d98a4}
    .upload input{display:none}.upload strong{display:block;color:#f0f3f6;font-size:13px;margin-bottom:5px}.upload span{font-size:10px;word-break:break-all}
    #map{height:300px;border-radius:13px;overflow:hidden;border:1px solid #303943}
    .coords{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:9px}
    .field{display:flex;flex-direction:column;gap:6px;margin-bottom:9px}.field label{font-size:10px;color:#84909c}
    input{width:100%;background:#090c10;color:#edf1f4;border:1px solid #303943;border-radius:10px;padding:10px 11px;outline:none;font:500 12px Inter,Arial,sans-serif}input:focus{border-color:#707c89}
    .actions{display:grid;grid-template-columns:1fr 1fr;gap:8px}.btn{border:1px solid #37414c;background:#12171d;color:#edf1f4;border-radius:10px;padding:10px 11px;font:700 11px Inter,Arial,sans-serif;cursor:pointer}.btn.primary{background:#f1f4f6;color:#0a0d11;border-color:#f1f4f6}.btn:disabled{opacity:.35;cursor:not-allowed}
    .hint,.statusline{font-size:10px;line-height:1.5;color:#707b87}.statusline{min-height:15px;margin-top:8px}
    .preview-head{display:flex;justify-content:space-between;align-items:center;padding:3px 4px 12px}.preview-head strong{font-size:13px}.small{font-size:10px;color:#7e8995;margin-top:3px}
    .canvas-box{min-height:680px;border-radius:13px;background:#030405;display:flex;align-items:center;justify-content:center;overflow:auto;padding:12px}.canvas-box canvas{max-width:100%;height:auto;display:block;border-radius:7px}.empty{color:#65717e;text-align:center;font-size:12px;line-height:1.8;padding:100px 20px}
    .leaflet-control-attribution{font-size:8px!important}.leaflet-control-layers{font-size:11px}
    @media(max-width:900px){.grid{grid-template-columns:1fr}.canvas-box{min-height:420px}h1{font-size:34px}.top{align-items:start;flex-direction:column}}
  </style>
</head>
<body>
<main>
  <header class="top">
    <div>
      <div class="eyebrow">GPS Map Camera</div>
      <h1>Real photo. Real GPS. Real map.</h1>
      <p class="sub">Create the same horizontal GPS camera stamp style as the reference: a real satellite map on the left, translucent information panel on the right, coordinates, address, date and time.</p>
    </div>
    <div class="pill">100% browser processing</div>
  </header>

  <div class="grid">
    <aside class="panel">
      <div class="section">
        <h2>01 · PHOTO</h2>
        <label class="upload">
          <input id="photoInput" type="file" accept="image/*" />
          <strong>Choose photo</strong>
          <span id="photoName">JPG, PNG or WebP</span>
        </label>
      </div>

      <div class="section">
        <h2>02 · LOCATION</h2>
        <div id="map"></div>
        <div class="coords">
          <div class="field"><label>Latitude</label><input id="lat" type="number" step="0.000001" value="23.978530" /></div>
          <div class="field"><label>Longitude</label><input id="lng" type="number" step="0.000001" value="85.359895" /></div>
        </div>
        <div class="actions">
          <button class="btn" id="gpsBtn">Use device GPS</button>
          <button class="btn" id="mapBtn">Update map</button>
        </div>
        <div class="statusline" id="locationStatus">Drag the pin or click the map.</div>
        <p class="hint">The exported stamp uses real satellite tiles centred on the selected coordinate. Address is reverse-geocoded automatically.</p>
      </div>

      <div class="section">
        <h2>03 · STAMP DATA</h2>
        <div class="field"><label>Place / title</label><input id="place" value="Hazaribagh, Jharkhand, India" /></div>
        <div class="field"><label>Address</label><input id="address" value="Sri RamaKrishna Sarada Ashrama Teacher's Training College, Hurhuru, Hazaribagh, Jharkhand 825301, India" /></div>
        <div class="field"><label>Date & time</label><input id="datetime" type="datetime-local" /></div>
        <div class="field"><label>Timezone label</label><input id="tz" value="GMT +05:30" /></div>
        <div class="field"><label>Map zoom</label><input id="zoom" type="number" min="10" max="19" value="17" /></div>
      </div>

      <div class="actions">
        <button class="btn primary" id="generateBtn">Generate GPS photo</button>
        <button class="btn" id="downloadBtn" disabled>Download JPEG</button>
      </div>
    </aside>

    <section class="preview">
      <div class="preview-head">
        <div><strong>Output preview</strong><div class="small">Reference layout: satellite map + dark translucent panel + GPS data</div></div>
        <div class="pill" id="status">Waiting for photo</div>
      </div>
      <div class="canvas-box" id="canvasBox">
        <div class="empty">Choose a photo to begin.<br />The generated image will use the actual photo dimensions.</div>
        <canvas id="canvas" hidden></canvas>
      </div>
    </section>
  </div>
</main>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<script src="https://cdn.jsdelivr.net/npm/piexifjs@1.0.6/piexif.min.js"></script>
<script>
const $=id=>document.getElementById(id);
const photoInput=$("photoInput"),photoName=$("photoName"),lat=$("lat"),lng=$("lng"),place=$("place"),address=$("address"),datetime=$("datetime"),tz=$("tz"),zoomInput=$("zoom"),canvas=$("canvas"),status=$("status"),locationStatus=$("locationStatus");
let sourceImage=null,marker,map,rendering=false,rerender=false,geocodeTimer;
const start=[Number(lat.value),Number(lng.value)];

map=L.map("map",{zoomControl:true}).setView(start,17);
const street=L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",{maxZoom:19,attribution:"&copy; OpenStreetMap contributors"});
const satellite=L.tileLayer("https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",{maxZoom:19,attribution:"Tiles &copy; Esri"}).addTo(map);
L.control.layers({"Satellite":satellite,"Street":street},null,{collapsed:true}).addTo(map);
marker=L.marker(start,{draggable:true}).addTo(map);

function valid(){const a=Number(lat.value),b=Number(lng.value);return Number.isFinite(a)&&Number.isFinite(b)&&a>=-90&&a<=90&&b>=-180&&b<=180}
function syncFromMap(){const p=marker.getLatLng();lat.value=p.lat.toFixed(6);lng.value=p.lng.toFixed(6);reverseGeocode(p.lat,p.lng);queueGenerate()}
marker.on("dragend",syncFromMap);
map.on("click",e=>{marker.setLatLng(e.latlng);syncFromMap()});

$("mapBtn").onclick=()=>{if(!valid())return;const p=[Number(lat.value),Number(lng.value)];marker.setLatLng(p);map.setView(p,Number(zoomInput.value)||17);reverseGeocode(p[0],p[1]);queueGenerate()};
$("gpsBtn").onclick=()=>{
  if(!navigator.geolocation){locationStatus.textContent="Device geolocation is not supported.";return}
  locationStatus.textContent="Getting high-accuracy GPS…";
  navigator.geolocation.getCurrentPosition(pos=>{
    const a=pos.coords.latitude,b=pos.coords.longitude;lat.value=a.toFixed(6);lng.value=b.toFixed(6);marker.setLatLng([a,b]);map.setView([a,b],18);reverseGeocode(a,b);locationStatus.textContent="Device GPS acquired ("+(pos.coords.accuracy?Math.round(pos.coords.accuracy)+" m accuracy":"high accuracy")+").";queueGenerate();
  },()=>locationStatus.textContent="GPS permission denied or unavailable.",{enableHighAccuracy:true,timeout:20000,maximumAge:0});
};

function setNow(){const d=new Date();datetime.value=new Date(d.getTime()-d.getTimezoneOffset()*60000).toISOString().slice(0,16)}setNow();
photoInput.onchange=()=>{const f=photoInput.files&&photoInput.files[0];if(!f)return;photoName.textContent=f.name;status.textContent="Loading photo…";const r=new FileReader();r.onload=()=>{sourceImage=new Image();sourceImage.onload=()=>{status.textContent="Ready";generate()};sourceImage.onerror=()=>status.textContent="Invalid image";sourceImage.src=r.result};r.readAsDataURL(f)};

async function reverseGeocode(a,b){
  clearTimeout(geocodeTimer);
  geocodeTimer=setTimeout(async()=>{
    locationStatus.textContent="Finding address…";
    try{
      const res=await fetch(`https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${encodeURIComponent(a)}&lon=${encodeURIComponent(b)}&zoom=18&addressdetails=1`,{headers:{Accept:"application/json"}});
      if(!res.ok)throw new Error("reverse geocode failed");
      const data=await res.json(),x=data.address||{};
      const city=x.city||x.town||x.village||x.municipality||x.county||"";
      const state=x.state||"",country=x.country||"";
      const title=[city,state,country].filter(Boolean).join(", ");
      if(title)place.value=title;
      if(data.display_name)address.value=data.display_name;
      locationStatus.textContent="Address updated automatically.";
      queueGenerate();
    }catch(e){locationStatus.textContent="GPS ready; address lookup unavailable."}
  },300);
}

function queueGenerate(){if(!sourceImage)return;if(rendering){rerender=true;return}generate()}
function fitFont(ctx,text,maxWidth,start,min){let size=start;while(size>min){ctx.font=`600 ${size}px Arial,sans-serif`;if(ctx.measureText(text).width<=maxWidth)return size;size--}return min}
function wrap(ctx,text,maxWidth,maxLines){const words=String(text||"").trim().split(/\s+/);const lines=[];let line="";for(const word of words){const test=line?line+" "+word:word;if(ctx.measureText(test).width>maxWidth&&line){lines.push(line);line=word;if(lines.length===maxLines-1)break}else line=test}if(line&&lines.length<maxLines)lines.push(line);return lines}
function rounded(ctx,x,y,w,h,r){ctx.beginPath();ctx.moveTo(x+r,y);ctx.arcTo(x+w,y,x+w,y+h,r);ctx.arcTo(x+w,y+h,x,y+h,r);ctx.arcTo(x,y+h,x,y,r);ctx.arcTo(x,y,x+w,y,r);ctx.closePath()}
function tileXY(a,b,z){const n=2**z,xx=(b+180)/360*n,rad=a*Math.PI/180,yy=(1-Math.asinh(Math.tan(rad))/Math.PI)/2*n;return{x:xx,y:yy}}
function tileUrl(z,x,y){const n=2**z;if(y<0||y>=n)return null;const xx=((x%n)+n)%n;return `https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/${z}/${y}/${xx}`}
function getTile(url){return new Promise(resolve=>{if(!url)return resolve(null);const im=new Image();im.crossOrigin="anonymous";im.onload=()=>resolve(im);im.onerror=()=>resolve(null);im.src=url})}
async function drawSatellite(ctx,x,y,w,h,a,b,z){
  const size=256,center=tileXY(a,b,z),cx=center.x*size,cy=center.y*size,left=cx-w/2,top=cy-h/2;
  ctx.save();rounded(ctx,x,y,w,h,5);ctx.clip();ctx.fillStyle="#4c5b48";ctx.fillRect(x,y,w,h);
  const x0=Math.floor(left/size)-1,x1=Math.floor((left+w)/size)+1,y0=Math.floor(top/size)-1,y1=Math.floor((top+h)/size)+1;
  const jobs=[];for(let ty=y0;ty<=y1;ty++)for(let tx=x0;tx<=x1;tx++){const u=tileUrl(z,tx,ty);jobs.push(Promise.resolve(getTile(u)).then(im=>({im,tx,ty})))}
  const tiles=await Promise.all(jobs);for(const t of tiles)if(t.im)ctx.drawImage(t.im,t.tx*size-left+x,t.ty*size-top+y,size,size);
  ctx.restore();
  // red location pin, deliberately styled like the reference image
  const px=x+w*.50,py=y+h*.49;ctx.save();ctx.fillStyle="#e52d2d";ctx.beginPath();ctx.moveTo(px,py+20);ctx.bezierCurveTo(px-7,py+9,px-12,py+3,px-12,py-5);ctx.arc(px,py-5,12,Math.PI,0);ctx.bezierCurveTo(px+12,py+3,px+7,py+9,px,py+20);ctx.fill();ctx.fillStyle="#fff";ctx.beginPath();ctx.arc(px,py-5,4.2,0,Math.PI*2);ctx.fill();ctx.restore();
  ctx.fillStyle="rgba(0,0,0,.45)";ctx.fillRect(x,y+h-28,w,28);ctx.font=`700 ${Math.max(11,Math.round(w*.065))}px Arial,sans-serif`;ctx.fillStyle="#fff";ctx.fillText("Google",x+10,y+h-7);
}

async function generate(){
  if(!sourceImage)return;if(rendering){rerender=true;return}rendering=true;rerender=false;status.textContent="Rendering real satellite map…";
  try{
    const W=sourceImage.naturalWidth||sourceImage.width,H=sourceImage.naturalHeight||sourceImage.height;canvas.width=W;canvas.height=H;const ctx=canvas.getContext("2d");ctx.imageSmoothingEnabled=true;ctx.imageSmoothingQuality="high";ctx.drawImage(sourceImage,0,0,W,H);
    // Reference proportions: map at far left, wide translucent panel immediately beside it, near the top.
    const margin=Math.max(10,Math.round(W*.012));
    const stampH=Math.max(145,Math.min(Math.round(W*.175),Math.round(H*.72)));
    const mapSize=Math.min(stampH-2,Math.max(130,Math.round(W*.166)));
    const mapX=margin,mapY=margin;
    const panelX=mapX+mapSize+Math.max(16,Math.round(W*.018));
    const panelY=mapY,panelW=W-panelX-margin,panelH=stampH;
    // Slight shadow behind the complete stamp.
    ctx.save();ctx.shadowColor="rgba(0,0,0,.30)";ctx.shadowBlur=Math.max(8,W*.012);ctx.shadowOffsetY=2;ctx.fillStyle="rgba(0,0,0,.02)";ctx.fillRect(mapX,mapY,mapSize,mapSize);rounded(ctx,panelX,panelY,panelW,panelH,9);ctx.fillStyle="rgba(24,28,34,.80)";ctx.fill();ctx.restore();
    await drawSatellite(ctx,mapX,mapY,mapSize,mapSize,Number(lat.value),Number(lng.value),Math.max(10,Math.min(19,Number(zoomInput.value)||17)));
    // Dark translucent information panel exactly to the right of the square map.
    ctx.save();rounded(ctx,panelX,panelY,panelW,panelH,9);ctx.fillStyle="rgba(20,24,29,.79)";ctx.fill();ctx.restore();
    const padX=Math.max(15,Math.round(W*.013));let tx=panelX+padX,ty=panelY+Math.max(17,Math.round(stampH*.10));
    const logoW=Math.max(175,Math.round(panelW*.22));const contentW=panelW-padX*2;
    const titleSize=Math.max(18,Math.min(32,Math.round(stampH*.145)));
    ctx.fillStyle="#f4f5f6";ctx.font=`700 ${titleSize}px Arial,sans-serif`;const titleLines=wrap(ctx,place.value,contentW-logoW,1);ctx.fillText(titleLines[0]||"",tx,ty+titleSize);
    // Small GPS Map Camera badge in the upper-right, matching the reference placement.
    const badgeX=panelX+panelW-logoW-padX/2,badgeY=panelY+Math.max(6,Math.round(stampH*.025));
    ctx.save();ctx.fillStyle="rgba(38,42,47,.92)";rounded(ctx,badgeX,badgeY,logoW,Math.max(42,Math.round(stampH*.24)),5);ctx.fill();
    const iconS=Math.max(25,Math.round(stampH*.19));ctx.fillStyle="#2b8eea";rounded(ctx,badgeX+7,badgeY+7,iconS,iconS,7);ctx.fill();ctx.fillStyle="#ffd33d";ctx.beginPath();ctx.arc(badgeX+7+iconS/2,badgeY+7+iconS/2,iconS*.27,0,Math.PI*2);ctx.fill();ctx.fillStyle="#ef4b3e";ctx.beginPath();ctx.arc(badgeX+7+iconS/2,badgeY+7+iconS*.36,iconS*.11,0,Math.PI*2);ctx.fill();ctx.fillStyle="#fff";ctx.font=`800 ${Math.max(12,Math.round(stampH*.10))}px Arial,sans-serif`;ctx.fillText("GPS Map Camera",badgeX+iconS+15,badgeY+iconS*.66);ctx.restore();
    ctx.fillStyle="#f0f2f4";ctx.font=`400 ${Math.max(11,Math.round(titleSize*.62))}px Arial,sans-serif`;
    const addressY=ty+titleSize+Math.max(9,Math.round(stampH*.055));const addressLines=wrap(ctx,address.value,contentW,2);addressLines.forEach((line,i)=>ctx.fillText(line,tx,addressY+i*Math.max(14,Math.round(stampH*.07))));
    const infoY=addressY+addressLines.length*Math.max(14,Math.round(stampH*.07))+Math.max(6,Math.round(stampH*.025));const infoSize=Math.max(11,Math.round(titleSize*.62));ctx.font=`400 ${infoSize}px Arial,sans-serif`;ctx.fillStyle="#f2f3f4";
    ctx.fillText(`Lat ${Number(lat.value).toFixed(5)}°`,tx,infoY);ctx.fillText(`Long ${Number(lng.value).toFixed(5)}°`,tx,infoY+Math.max(20,Math.round(stampH*.105)));
    const d=new Date(datetime.value||Date.now());const date=d.toLocaleDateString("en-GB",{day:"2-digit",month:"2-digit",year:"2-digit"});const time=d.toLocaleTimeString("en-US",{hour:"2-digit",minute:"2-digit",hour12:true});ctx.fillText(`${date} ${time} ${tz.value}`,tx,infoY+Math.max(40,Math.round(stampH*.21)));
    canvas.hidden=false;$("canvasBox").querySelector(".empty")?.remove();$("downloadBtn").disabled=false;status.textContent="Generated";
  }finally{rendering=false;if(rerender){rerender=false;generate()}}
}

function exifDataUrl(dataUrl){
  if(typeof piexif==="undefined")return dataUrl;
  try{
    const a=Math.abs(Number(lat.value)),b=Math.abs(Number(lng.value));
    const dms=v=>{const deg=Math.floor(v),m0=(v-deg)*60,min=Math.floor(m0),sec=Math.round((m0-min)*60*100);return [[deg,1],[min,1],[sec,100]]};
    const d=new Date(datetime.value||Date.now()),p=n=>String(n).padStart(2,"0");
    const exif={"0th":{"270":`${place.value} | ${address.value}`},"Exif":{"36867":`${d.getFullYear()}:${p(d.getMonth()+1)}:${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}:${p(d.getSeconds())}`},"GPS":{"1":Number(lat.value)>=0?"N":"S","2":dms(a),"3":Number(lng.value)>=0?"E":"W","4":dms(b),"29":`${d.getUTCFullYear()}:${p(d.getUTCMonth()+1)}:${p(d.getUTCDate())}`}};
    return piexif.insert(piexif.dump(exif),dataUrl);
  }catch(e){return dataUrl}
}

$("generateBtn").onclick=generate;
$("downloadBtn").onclick=()=>{if(!canvas.width)return;status.textContent="Preparing JPEG…";const raw=canvas.toDataURL("image/jpeg",.96);const data=exifDataUrl(raw);const a=document.createElement("a");a.download="gps-map-camera.jpg";a.href=data;a.click();status.textContent="Downloaded"};
[lat,lng,place,address,datetime,tz,zoomInput].forEach(el=>el.addEventListener("input",()=>{if(el===lat||el===lng){if(valid()){marker.setLatLng([Number(lat.value),Number(lng.value)]);map.panTo([Number(lat.value),Number(lng.value)])}}queueGenerate()}));
</script>
</body>
</html>
