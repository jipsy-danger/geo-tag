<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>GPS Map Camera</title>
<meta name="description" content="Create real GPS Map Camera style geotagged photos in your browser." />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
<style>
:root{font-family:Inter,system-ui,sans-serif;color:#f5f7fa;background:#080a0d}*{box-sizing:border-box}body{margin:0;min-height:100vh;background:radial-gradient(circle at 80% -10%,#26303a 0,#10151b 38%,#080a0d 70%)}main{max-width:1320px;margin:auto;padding:34px 22px 56px}.top{display:flex;justify-content:space-between;align-items:flex-end;gap:25px;margin-bottom:24px}.eyebrow{text-transform:uppercase;letter-spacing:.18em;font-size:11px;color:#9aa5b2;font-weight:800}.title{font-size:40px;line-height:1.04;margin:7px 0;letter-spacing:-.045em}.sub{margin:0;color:#aab3bd;max-width:720px;line-height:1.55}.badge{font-size:11px;color:#aeb8c3;border:1px solid #303943;padding:6px 9px;border-radius:999px;white-space:nowrap}.grid{display:grid;grid-template-columns:365px minmax(0,1fr);gap:20px}.panel,.preview{border:1px solid #29313a;background:rgba(14,18,23,.9);backdrop-filter:blur(16px);border-radius:20px;box-shadow:0 22px 65px rgba(0,0,0,.3)}.panel{padding:18px}.section{padding-bottom:18px;margin-bottom:18px;border-bottom:1px solid #252c34}.section h3{font-size:12px;margin:0 0 10px;color:#d3dae2}.field{display:flex;flex-direction:column;gap:6px;margin-bottom:10px}.field label{font-size:11px;color:#84909d}.field input{width:100%;background:#090c10;color:#edf2f6;border:1px solid #303943;border-radius:10px;padding:10px 11px;outline:none;font:inherit;font-size:12px}.field input:focus{border-color:#778392}.upload{display:block;border:1px dashed #46515e;border-radius:14px;padding:18px;text-align:center;color:#8f9aa7;cursor:pointer;background:#0b0f14}.upload input{display:none}.upload strong{display:block;color:#edf2f5;font-size:13px;margin-bottom:5px}.upload span{font-size:11px;word-break:break-all}.map-wrap{height:300px;border-radius:13px;overflow:hidden;border:1px solid #303943}.coords{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:9px}.actions{display:grid;grid-template-columns:1fr 1fr;gap:8px}.btn{border:1px solid #37414c;background:#12171d;color:#edf1f4;border-radius:10px;padding:10px 11px;font:700 11px Inter,sans-serif;cursor:pointer}.btn.primary{background:#f1f4f6;color:#0b0e12;border-color:#f1f4f6}.btn:disabled{opacity:.4;cursor:not-allowed}.hint{font-size:10px;color:#707b87;line-height:1.5;margin:8px 0 0}.statusline{font-size:10px;color:#788492;margin-top:8px;min-height:15px}.preview{padding:13px}.preview-head{display:flex;justify-content:space-between;align-items:center;padding:3px 4px 12px}.small{font-size:11px;color:#7f8a97;margin-top:3px}.canvas-box{background:#050607;border-radius:13px;min-height:650px;display:flex;align-items:center;justify-content:center;overflow:auto;padding:10px}.canvas-box canvas{max-width:100%;height:auto;display:block;border-radius:8px}.empty{color:#66727f;text-align:center;padding:90px 20px;font-size:12px;line-height:1.8}.leaflet-control-attribution{font-size:8px!important}@media(max-width:900px){.grid{grid-template-columns:1fr}.title{font-size:34px}.canvas-box{min-height:400px}}
</style>
</head>
<body>
<main>
<div class="top"><div><div class="eyebrow">GPS Map Camera</div><h1 class="title">Real location. Real map. Real stamp.</h1><p class="sub">Upload a photo, pick the exact point on the live map or use device GPS, reverse-geocode the location, and create a GPS Map Camera style photograph. The photo never leaves your browser.</p></div><div class="badge">Browser-only processing</div></div>
<div class="grid">
<aside class="panel">
<div class="section"><h3>01 · PHOTO</h3><label class="upload"><input id="photoInput" type="file" accept="image/jpeg,image/png,image/webp,image/*"/><strong>Choose photo</strong><span id="photoName">JPG, PNG or WebP</span></label></div>
<div class="section"><h3>02 · LIVE LOCATION</h3><div id="map" class="map-wrap"></div><div class="coords"><div class="field"><label>Latitude</label><input id="lat" type="number" step="0.000001" value="23.978530"/></div><div class="field"><label>Longitude</label><input id="lng" type="number" step="0.000001" value="85.359895"/></div></div><div class="actions"><button class="btn" id="locateBtn">Use device GPS</button><button class="btn" id="updateMapBtn">Update map</button></div><div class="statusline" id="locationStatus">Map point ready.</div><p class="hint">Click the live map or drag the pin. Coordinates and address update from the selected point.</p></div>
<div class="section"><h3>03 · PHOTO STAMP</h3><div class="field"><label>Place / title</label><input id="place" value="Hazaribagh, Jharkhand, India"/></div><div class="field"><label>Address</label><input id="address" value="Sri RamaKrishna Sarada Ashrama Teacher's Training College, Hurhuru, Hazaribagh, Jharkhand 825301, India"/></div><div class="field"><label>Date & time</label><input id="datetime" type="datetime-local"/></div><div class="field"><label>Timezone</label><input id="tz" value="GMT +05:30"/></div><div class="field"><label>Map zoom in photo</label><input id="mapZoom" type="number" min="12" max="18" value="16"/></div></div>
<div class="actions"><button class="btn primary" id="generateBtn">Generate GPS photo</button><button class="btn" id="downloadBtn" disabled>Download JPEG</button></div>
</aside>
<section class="preview"><div class="preview-head"><div><strong>Output preview</strong><div class="small">Actual map tiles are rendered into the exported image</div></div><div class="badge" id="status">Waiting for photo</div></div><div class="canvas-box" id="canvasBox"><div class="empty">Choose a photo to begin.<br/>Then select a real location on the map.</div><canvas id="canvas" hidden></canvas></div></section>
</div>
</main>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<script src="https://cdn.jsdelivr.net/npm/piexifjs@1.0.6/piexif.min.js"></script>
<script>
const $=id=>document.getElementById(id);
const photoInput=$("photoInput"),photoName=$("photoName"),lat=$("lat"),lng=$("lng"),place=$("place"),address=$("address"),datetime=$("datetime"),tz=$("tz"),mapZoom=$("mapZoom"),canvas=$("canvas"),status=$("status"),locationStatus=$("locationStatus");
let image=null,marker=null,map=null,lastMapPoint=null,geocodeTimer=null;
const initial=[Number(lat.value),Number(lng.value)];
map=L.map("map",{zoomControl:true}).setView(initial,15);
L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",{maxZoom:19,crossOrigin:true,attribution:"&copy; OpenStreetMap contributors"}).addTo(map);
marker=L.marker(initial,{draggable:true}).addTo(map);
function validPoint(){const a=Number(lat.value),b=Number(lng.value);return Number.isFinite(a)&&Number.isFinite(b)&&a>=-90&&a<=90&&b>=-180&&b<=180}
function syncInputs(){const p=marker.getLatLng();lat.value=p.lat.toFixed(6);lng.value=p.lng.toFixed(6);lastMapPoint=p;reverseGeocode(p.lat,p.lng);if(image)generate()}
async function reverseGeocode(la,lo){clearTimeout(geocodeTimer);geocodeTimer=setTimeout(async()=>{locationStatus.textContent="Looking up address…";try{const r=await fetch("https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat="+encodeURIComponent(la)+"&lon="+encodeURIComponent(lo)+"&zoom=18&addressdetails=1");if(!r.ok)throw new Error("geocoder");const d=await r.json();const a=d.address||{};const city=a.city||a.town||a.village||a.municipality||a.county||"";const state=a.state||"";const country=a.country||"";const title=[city,state,country].filter(Boolean).join(", ");if(title)place.value=title;if(d.display_name)address.value=d.display_name;locationStatus.textContent="Address updated automatically";if(image)generate()}catch(e){locationStatus.textContent="Coordinates ready; address lookup unavailable"}},350)}
marker.on("dragend",syncInputs);
map.on("click",e=>{marker.setLatLng(e.latlng);syncInputs()});
$("updateMapBtn").onclick=()=>{if(!validPoint())return;const p=[Number(lat.value),Number(lng.value)];marker.setLatLng(p);map.setView(p,16);reverseGeocode(p[0],p[1]);if(image)generate()};
$("locateBtn").onclick=()=>{if(!navigator.geolocation){locationStatus.textContent="Geolocation is not supported";return}locationStatus.textContent="Requesting device GPS…";navigator.geolocation.getCurrentPosition(pos=>{lat.value=pos.coords.latitude.toFixed(6);lng.value=pos.coords.longitude.toFixed(6);marker.setLatLng([pos.coords.latitude,pos.coords.longitude]);map.setView([pos.coords.latitude,pos.coords.longitude],17);reverseGeocode(pos.coords.latitude,pos.coords.longitude);locationStatus.textContent="Device GPS location acquired";if(image)generate()},()=>locationStatus.textContent="GPS permission denied or unavailable",{enableHighAccuracy:true,timeout:15000,maximumAge:0})};
function setNow(){const d=new Date();datetime.value=new Date(d.getTime()-d.getTimezoneOffset()*60000).toISOString().slice(0,16)}setNow();
photoInput.onchange=()=>{const f=photoInput.files?.[0];if(!f)return;photoName.textContent=f.name;status.textContent="Loading";const reader=new FileReader();reader.onload=()=>{image=new Image();image.onload=()=>{status.textContent="Ready";generate()};image.onerror=()=>status.textContent="Invalid image";image.src=reader.result};reader.readAsDataURL(f)};
function wrapText(ctx,text,max){const words=String(text||"").split(/\s+/);const lines=[];let line="";for(const word of words){const t=line?line+" "+word:word;if(ctx.measureText(t).width>max&&line){lines.push(line);line=word}else line=t}if(line)lines.push(line);return lines}
function roundRect(ctx,x,y,w,h,r){ctx.beginPath();ctx.moveTo(x+r,y);ctx.arcTo(x+w,y,x+w,y+h,r);ctx.arcTo(x+w,y+h,x,y+h,r);ctx.arcTo(x,y+h,x,y,r);ctx.arcTo(x,y,x+w,y,r);ctx.closePath()}
function dms(value,isLat){const abs=Math.abs(Number(value));const deg=Math.floor(abs);const minFloat=(abs-deg)*60;const min=Math.floor(minFloat);const sec=(minFloat-min)*60;return [deg,min,sec]}
function addExif(dataUrl){if(typeof piexif==="undefined")return dataUrl;try{const la=Number(lat.value),lo=Number(lng.value),ad=dms(la,true),od=dms(lo,false);const d=new Date(datetime.value||Date.now());const pad=n=>String(n).padStart(2,"0");const exif={"0th":{"270":place.value+" | "+address.value},"Exif":{"36867":d.getFullYear()+":"+pad(d.getMonth()+1)+":"+pad(d.getDate())+" "+pad(d.getHours())+":"+pad(d.getMinutes())+":"+pad(d.getSeconds())},"GPS":{"1":la>=0?"N":"S","2":[[ad[0],1],[ad[1],1],[Math.round(ad[2]*100),100]],"3":lo>=0?"E":"W","4":[[od[0],1],[od[1],1],[Math.round(od[2]*100),100]],"7":[[d.getUTCHours(),1],[d.getUTCMinutes(),1],[d.getUTCSeconds(),1]],"29":d.getUTCFullYear()+":"+pad(d.getUTCMonth()+1)+":"+pad(d.getUTCDate())}};return piexif.insert(piexif.dump(exif),dataUrl)}catch(e){return dataUrl}}
function tileXY(la,lo,z){const n=2**z;const x=(lo+180)/360*n;const latRad=la*Math.PI/180;const y=(1-Math.asinh(Math.tan(latRad))/Math.PI)/2*n;return{x,y}}
async function loadTile(x,y,z){const n=2**z;const xx=((x%n)+n)%n;if(y<0||y>=n)return null;return new Promise((resolve,reject)=>{const im=new Image();im.crossOrigin="anonymous";im.onload=()=>resolve(im);im.onerror=()=>reject(new Error("tile"));im.src="https://tile.openstreetmap.org/"+z+"/"+xx+"/"+y+".png"})}
async function drawRealMap(ctx,x,y,w,h,la,lo,z){const tile=256;const center=tileXY(la,lo,z);const cx=center.x*tile,cy=center.y*tile;const left=cx-w/2,top=cy-h/2;const tx0=Math.floor(left/tile)-1,ty0=Math.floor(top/tile)-1,tx1=Math.floor((left+w)/tile)+1,ty1=Math.floor((top+h)/tile)+1;ctx.save();roundRect(ctx,x,y,w,h,10);ctx.clip();ctx.fillStyle="#dbe3dc";ctx.fillRect(x,y,w,h);for(let ty=ty0;ty<=ty1;ty++){for(let tx=tx0;tx<=tx1;tx++){try{const im=await loadTile(tx,ty,z);if(im)ctx.drawImage(im,tx*tile-left+x,ty*tile-top+y,tile,tile)}catch(e){}}}const px=x+w/2,py=y+h/2;ctx.fillStyle="#d62828";ctx.beginPath();ctx.arc(px,py,9,0,Math.PI*2);ctx.fill();ctx.fillStyle="#fff";ctx.beginPath();ctx.arc(px,py,3,0,Math.PI*2);ctx.fill();ctx.strokeStyle="rgba(0,0,0,.55)";ctx.lineWidth=2;ctx.stroke();ctx.restore();ctx.fillStyle="rgba(0,0,0,.7)";ctx.fillRect(x,y+h-23,w,23);ctx.fillStyle="#fff";ctx.font="700 11px Inter,sans-serif";ctx.fillText("OpenStreetMap",x+8,y+h-8)}
let generating=false,queued=false;
async function generate(){if(!image||generating){queued=true;return}generating=true;queued=false;status.textContent="Rendering map";const scale=1;canvas.width=image.width*scale;canvas.height=image.height*scale;const ctx=canvas.getContext("2d");ctx.imageSmoothingQuality="high";ctx.drawImage(image,0,0,canvas.width,canvas.height);const pad=Math.max(24,Math.round(canvas.width*.022));const panelH=Math.max(180,Math.min(Math.round(canvas.width*.19),Math.round(canvas.height*.31)));const x=pad,y=canvas.height-panelH-pad,w=canvas.width-pad*2,h=panelH;ctx.fillStyle="rgba(12,16,21,.84)";roundRect(ctx,x,y,w,h,12);ctx.fill();const inset=Math.max(14,Math.round(w*.014));const mapW=Math.min(Math.round(w*.24),Math.max(145,Math.round(canvas.width*.19)));const mapH=h-inset*2;const textW=w-mapW-inset*3;const left=x+inset,top=y+inset;const titleSize=Math.max(20,Math.round(canvas.width*.027));ctx.font="800 "+titleSize+"px Inter,sans-serif";ctx.fillStyle="#fff";ctx.fillText(place.value||"Location",left,top+titleSize);ctx.font="500 "+Math.max(11,Math.round(titleSize*.58))+"px Inter,sans-serif";ctx.fillStyle="#f3f5f7";const lines=wrapText(ctx,address.value,textW);lines.slice(0,2).forEach((line,i)=>ctx.fillText(line,left,top+titleSize+23+i*16));const base=top+titleSize+23+Math.min(2,lines.length)*16+11;ctx.font="600 "+Math.max(12,Math.round(titleSize*.62))+"px Inter,sans-serif";ctx.fillText("Lat "+Number(lat.value).toFixed(5)+"°",left,base);ctx.fillText("Long "+Number(lng.value).toFixed(5)+"°",left,base+23);const d=new Date(datetime.value||Date.now());const date=d.toLocaleDateString("en-GB",{day:"2-digit",month:"2-digit",year:"2-digit"});const time=d.toLocaleTimeString("en-US",{hour:"2-digit",minute:"2-digit",hour12:true});ctx.fillText(date+" "+time+" "+tz.value,left,base+46);const mapX=x+w-mapW-inset;try{await drawRealMap(ctx,mapX,y+inset,mapW,mapH,Number(lat.value),Number(lng.value),Math.max(12,Math.min(18,Number(mapZoom.value)||16)))}catch(e){}ctx.font="800 "+Math.max(10,Math.round(titleSize*.47))+"px Inter,sans-serif";ctx.fillStyle="#fff";ctx.fillText("GPS MAP CAMERA",x+w-135,y+h-12);canvas.hidden=false;$("canvasBox").querySelector(".empty")?.remove();$("downloadBtn").disabled=false;status.textContent="Generated";generating=false;if(queued)generate()}
$("generateBtn").onclick=generate;
$("downloadBtn").onclick=()=>{if(!canvas.width)return;status.textContent="Preparing JPEG";let data=canvas.toDataURL("image/jpeg",.96);data=addExif(data);const a=document.createElement("a");a.download="geo-tagged-photo.jpg";a.href=data;a.click();status.textContent="Downloaded with GPS EXIF"};
[lat,lng,mapZoom].forEach(el=>el.addEventListener("input",()=>{if(image)generate()}));[place,address,datetime,tz].forEach(el=>el.addEventListener("input",()=>{if(image)generate()}));
reverseGeocode(initial[0],initial[1]);
</script>
</body>
</html>
