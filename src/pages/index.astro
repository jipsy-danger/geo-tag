<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>GPS Map Camera</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
<style>
*{box-sizing:border-box}html,body{margin:0;background:#080b0f;color:#f4f5f6;font-family:Arial,Helvetica,sans-serif}body{min-height:100vh}.shell{max-width:1250px;margin:auto;padding:28px 22px 55px}.top{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:18px}.kicker{font-size:11px;letter-spacing:.18em;font-weight:700;color:#87929d}.top h1{font-size:38px;margin:7px 0 8px;letter-spacing:-.04em}.top p{margin:0;color:#9ca7b2;font-size:14px}.live{border:1px solid #34404b;border-radius:99px;padding:7px 11px;font-size:10px;color:#9ba6b0}.layout{display:grid;grid-template-columns:350px 1fr;gap:18px}.card{background:#10151b;border:1px solid #28313a;border-radius:18px;box-shadow:0 25px 70px #0008}.controls{padding:16px}.block{padding-bottom:15px;margin-bottom:15px;border-bottom:1px solid #252d35}.block h2{font-size:10px;margin:0 0 9px;letter-spacing:.06em}.upload{display:block;border:1px dashed #4b5662;border-radius:12px;background:#0b0f14;padding:18px;text-align:center;cursor:pointer}.upload input{display:none}.upload b{display:block;font-size:13px;margin-bottom:4px}.upload span{font-size:10px;color:#7e8994}.cameraBtns{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:8px}.btn{border:1px solid #37424e;background:#151b21;color:#f2f4f5;border-radius:9px;padding:10px 9px;font-size:11px;font-weight:700;cursor:pointer}.btn.primary{background:#f4f5f6;color:#0b0e12}.btn:disabled{opacity:.35;cursor:not-allowed}#map{height:285px;border-radius:12px;overflow:hidden;border:1px solid #303a44}.coords{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:8px}.field{margin-top:8px}.field label{display:block;color:#7f8a95;font-size:9px;margin-bottom:5px}.field input{width:100%;border:1px solid #303a44;background:#090d12;color:#f2f4f5;border-radius:8px;padding:9px;font-size:11px;outline:none}.status{font-size:10px;color:#75818c;min-height:14px;margin-top:7px}.hint{font-size:9px;color:#68747f;line-height:1.5}.preview{padding:12px}.previewHead{height:34px;display:flex;justify-content:space-between;align-items:center}.previewHead b{font-size:12px}.previewHead small{display:block;color:#68747f;font-size:9px;margin-top:2px}.stage{position:relative;background:#020304;border-radius:11px;overflow:hidden;min-height:690px;display:flex;align-items:center;justify-content:center}.media{position:relative;max-width:100%;max-height:690px;overflow:hidden}.media video,.media img{display:block;max-width:100%;max-height:690px;width:auto;height:auto;object-fit:contain}.media video{background:#000}.stamp{position:absolute;left:1.1%;top:2.4%;right:1.1%;display:flex;align-items:stretch;pointer-events:none;filter:drop-shadow(0 3px 7px #0008)}.stampMap{width:16.5%;aspect-ratio:1/1;min-width:90px;overflow:hidden;background:#3b4939;border-radius:3px;position:relative}.stampMap img{width:100%;height:100%;object-fit:cover}.pin{position:absolute;left:50%;top:50%;width:17px;height:17px;background:#e8332e;border:2px solid #fff;border-radius:50% 50% 50% 0;transform:translate(-50%,-65%) rotate(-45deg);box-shadow:0 1px 3px #0008}.pin:after{content:"";position:absolute;width:5px;height:5px;background:#fff;border-radius:50%;left:4px;top:4px}.mapCredit{position:absolute;bottom:2px;left:4px;font-size:9px;color:#fff;text-shadow:0 1px 2px #000}.stampInfo{flex:1;background:rgba(20,24,29,.82);border-radius:4px;padding:1.7% 1.35%;min-width:0;position:relative}.title{font-size:clamp(13px,2.1vw,30px);font-weight:700;line-height:1.08;padding-right:24%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.addr{font-size:clamp(7px,1vw,15px);line-height:1.2;margin-top:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding-right:2%}.coord{font-size:clamp(8px,1.05vw,15px);line-height:1.35;margin-top:4px}.time{font-size:clamp(8px,1.05vw,15px);margin-top:4px}.badge{position:absolute;right:1.5%;bottom:5%;top:auto;display:block;white-space:nowrap;line-height:0}.badgeLogo{display:block;width:clamp(110px,15vw,220px);height:auto}.watermark{position:absolute;right:14px;bottom:14px;width:clamp(120px,20%,220px);height:auto;z-index:8;filter:drop-shadow(0 2px 5px #000c);pointer-events:none}.empty{color:#697580;font-size:11px;text-align:center;padding:90px}.captureRow{display:flex;gap:8px;justify-content:center;position:absolute;bottom:18px;left:0;right:0}.capture{width:58px;height:58px;border-radius:50%;border:4px solid #fff;background:#fff8;box-shadow:0 2px 10px #0009;cursor:pointer}.capture span{display:block;width:43px;height:43px;background:#fff;border-radius:50%;margin:auto}.mode{position:absolute;top:14px;left:14px;background:#0009;border:1px solid #fff3;color:#fff;padding:6px 9px;border-radius:99px;font-size:9px}.leaflet-control-attribution{font-size:7px!important}
@media(max-width:900px){.layout{grid-template-columns:1fr}.stage{min-height:450px}.top{align-items:flex-start;gap:10px;flex-direction:column}}
</style>
</head>
<body>
<div class="shell">
<header class="top"><div><div class="kicker">GPS MAP CAMERA</div><h1>Real-time geotag camera</h1><p>Live camera + live GPS + real satellite map + automatic location data.</p></div><div class="live" id="gpsState">GPS waiting</div></header>
<div class="layout">
<aside class="card controls">
<div class="block"><h2>01 · CAMERA</h2><div class="cameraBtns"><button class="btn primary" id="startCamera">Open camera</button><button class="btn" id="stopCamera">Stop camera</button></div><label class="upload"><input id="photo" type="file" accept="image/*"/><b>Upload existing photo</b><span id="fileName">Use camera or choose a local image</span></label></div>
<div class="block"><h2>02 · LIVE LOCATION</h2><div id="map"></div><div class="coords"><div class="field"><label>Latitude</label><input id="lat" type="number" step="0.000001" value="23.978530"></div><div class="field"><label>Longitude</label><input id="lng" type="number" step="0.000001" value="85.359895"></div></div><div class="cameraBtns"><button class="btn" id="gps">Start live GPS</button><button class="btn" id="update">Update map</button></div><div class="status" id="locationStatus">Click map, drag pin, or start GPS.</div></div>
<div class="block"><h2>03 · REAL STAMP DATA</h2><div class="field"><label>Place</label><input id="place" value="Hazaribagh, Jharkhand, India"></div><div class="field"><label>Address</label><input id="address" value="Sri RamaKrishna Sarada Ashrama Teacher's Training College, Hurhuru, Hazaribagh, Jharkhand 825301, India"></div><div class="field"><label>Date & time</label><input id="date" type="datetime-local"></div><div class="field"><label>Timezone</label><input id="zone" value="GMT +05:30"></div><p class="hint">GPS updates continuously while the page is open. The address is reverse-geocoded after a location change.</p></div>
<div class="cameraBtns"><button class="btn primary" id="capture">Capture stamped photo</button><button class="btn" id="download" disabled>Download JPEG</button></div>
</aside>
<section class="card preview"><div class="previewHead"><div><b>Live camera preview</b><small id="previewText">Allow camera permission to shoot like a GPS camera.</small></div><div class="live" id="modeText">LIVE</div></div><div class="stage" id="stage"><div class="empty" id="empty">Open camera or upload a photo.<br>GPS data and timestamp will appear on the real image.</div><div class="media" id="media" hidden><video id="video" playsinline autoplay muted></video><img id="photoPreview" alt="" hidden><div class="stamp"><div class="stampMap"><img id="stampMap" alt="Satellite map"><div class="pin"></div><div class="mapCredit">Satellite</div></div><div class="stampInfo"><div class="title" id="stampPlace">Hazaribagh, Jharkhand, India</div><div class="addr" id="stampAddress">Sri RamaKrishna Sarada Ashrama Teacher's Training College, Hurhuru, Hazaribagh, Jharkhand 825301, India</div><div class="coord" id="stampLat">Lat 23.97853°</div><div class="coord" id="stampLng">Long 85.359895°</div><div class="time" id="stampTime">16/09/26 03:00 PM GMT +05:30</div><div class="badge"><img class="badgeLogo" src="/geo-tag/gps-map-camera-logo.svg" alt="GPS Map Camera"></div></div></div><img class="watermark" src="/geo-tag/gps-map-camera-logo.svg" alt="GPS Map Camera logo"></div><div class="mode" id="accuracy">NO GPS</div><div class="captureRow"><button class="capture" id="shutter" title="Capture"><span></span></button></div></div></section>
</div></div>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<script src="https://cdn.jsdelivr.net/npm/piexifjs@1.0.6/piexif.min.js"></script>
<script>
const $=id=>document.getElementById(id);let stream=null,watch=null,map,marker,source=null,lastMapUrl='',lastFix=null,geoBusy=false;
const lat=$("lat"),lng=$("lng"),place=$("place"),address=$("address"),date=$("date"),zone=$("zone"),video=$("video"),img=$("photoPreview"),media=$("media"),empty=$("empty");
const LOGO_URL='/geo-tag/gps-map-camera-logo.svg';let logoImage=null;function loadLogo(){logoImage=new Image();logoImage.crossOrigin='anonymous';logoImage.src=LOGO_URL;return new Promise(r=>{logoImage.onload=r;logoImage.onerror=r})}loadLogo();
function now(){const d=new Date();date.value=new Date(d-d.getTimezoneOffset()*60000).toISOString().slice(0,16)}now();
setInterval(()=>{if(!date.matches(':focus'))now();renderStamp()},1000);
map=L.map('map').setView([+lat.value,+lng.value],17);const sat=L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',{maxZoom:19,attribution:'Tiles © Esri'}).addTo(map);const street=L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19,attribution:'© OpenStreetMap'});L.control.layers({'Satellite':sat,'Street':street}).addTo(map);marker=L.marker([+lat.value,+lng.value],{draggable:true}).addTo(map);
function setPoint(a,b){lat.value=a.toFixed(6);lng.value=b.toFixed(6);marker.setLatLng([a,b]);map.setView([a,b],Math.max(16,map.getZoom()));reverse(a,b);refreshMap();renderStamp()}
marker.on('dragend',()=>{const p=marker.getLatLng();setPoint(p.lat,p.lng)});map.on('click',e=>setPoint(e.latlng.lat,e.latlng.lng));
$('update').onclick=()=>{const a=+lat.value,b=+lng.value;if(Number.isFinite(a)&&Number.isFinite(b))setPoint(a,b)};
$('gps').onclick=()=>startGPS();
function startGPS(){if(!navigator.geolocation){$('locationStatus').textContent='Geolocation is not supported.';return}if(watch!==null)navigator.geolocation.clearWatch(watch);$('gpsState').textContent='GPS active';$('locationStatus').textContent='Waiting for high-accuracy GPS…';watch=navigator.geolocation.watchPosition(pos=>{lastFix=pos;$('gpsState').textContent='GPS ±'+Math.round(pos.coords.accuracy||0)+' m';$('accuracy').textContent=(pos.coords.accuracy?Math.round(pos.coords.accuracy)+' m':'GPS');const a=pos.coords.latitude,b=pos.coords.longitude;lat.value=a.toFixed(6);lng.value=b.toFixed(6);marker.setLatLng([a,b]);map.panTo([a,b],{animate:false});reverse(a,b);refreshMap();renderStamp()},err=>{$('gpsState').textContent='GPS unavailable';$('locationStatus').textContent=err.message},{enableHighAccuracy:true,maximumAge:0,timeout:15000})}
async function reverse(a,b){if(geoBusy)return;geoBusy=true;try{const r=await fetch('https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat='+a+'&lon='+b+'&zoom=18&addressdetails=1');if(r.ok){const d=await r.json();if(d.display_name)address.value=d.display_name;const x=d.address||{};const c=x.city||x.town||x.village||x.municipality||x.county||'';const s=x.state||'';const co=x.country||'';if(c||s||co)place.value=[c,s,co].filter(Boolean).join(', ');$('locationStatus').textContent='Address updated from live coordinates.'}}catch(e){}geoBusy=false;renderStamp()}
function refreshMap(){const z=Math.max(15,Math.min(19,map.getZoom()||17));const a=+lat.value,b=+lng.value;lastMapUrl='https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/export?bbox='+encodeURIComponent(b-.0015)+','+encodeURIComponent(a-.001)+','+encodeURIComponent(b+.0015)+','+encodeURIComponent(a+.001)+'&bboxSR=4326&size=900,900&imageSR=4326&format=jpg&f=image';$('stampMap').src=lastMapUrl}
function stampText(){const d=new Date(date.value||Date.now());const dd=String(d.getDate()).padStart(2,'0'),mm=String(d.getMonth()+1).padStart(2,'0'),yy=String(d.getFullYear()).slice(-2);let h=d.getHours(),ampm=h>=12?'PM':'AM';h=h%12||12;const t=String(h).padStart(2,'0')+':'+String(d.getMinutes()).padStart(2,'0')+' '+ampm;return dd+'/'+mm+'/'+yy+' '+t+' '+zone.value}
function renderStamp(){$('stampPlace').textContent=place.value;$('stampAddress').textContent=address.value;$('stampLat').textContent='Lat '+(+lat.value).toFixed(5)+'°';$('stampLng').textContent='Long '+(+lng.value).toFixed(5)+'°';$('stampTime').textContent=stampText()}
async function openCamera(){try{stream=await navigator.mediaDevices.getUserMedia({video:{facingMode:{ideal:'environment'},width:{ideal:1920},height:{ideal:1080}},audio:false});video.srcObject=stream;video.hidden=false;img.hidden=true;media.hidden=false;empty.hidden=true;$('modeText').textContent='CAMERA LIVE';$('previewText').textContent='Live camera feed. GPS stamp follows the current fix.';startGPS();renderStamp()}catch(e){$('previewText').textContent='Camera permission was denied or unavailable. You can still upload a photo.'}}
function stopCamera(){if(stream){stream.getTracks().forEach(t=>t.stop());stream=null}video.srcObject=null}
$('startCamera').onclick=openCamera;$('stopCamera').onclick=stopCamera;
$('photo').onchange=e=>{const f=e.target.files?.[0];if(!f)return;$('fileName').textContent=f.name;const r=new FileReader();r.onload=()=>{source=new Image();source.onload=()=>{img.src=source.src;img.hidden=false;video.hidden=true;media.hidden=false;empty.hidden=true;$('modeText').textContent='PHOTO';$('previewText').textContent='Uploaded photo with live GPS stamp.';renderStamp()};source.src=r.result};r.readAsDataURL(f)};
$('capture').onclick=()=>capture();$('shutter').onclick=()=>capture();
async function capture(){if(!source&&!stream&&video.readyState<2){$('previewText').textContent='Open the camera or upload a photo first.';return}const base=source||video;const w=base.videoWidth||base.naturalWidth||base.width,h=base.videoHeight||base.naturalHeight||base.height;if(!w||!h)return;const c=document.createElement('canvas');c.width=w;c.height=h;const x=c.getContext('2d');x.drawImage(base,0,0,w,h);const margin=Math.max(18,Math.round(w*.012)),mh=Math.round(Math.min(h*.30,w*.175)),mw=Math.round(mh);const px=margin+mw+Math.round(w*.018),py=margin,pw=w-px-margin;await drawMap(x,margin,margin,mw,mw);x.fillStyle='rgba(20,24,29,.84)';round(x,px,py,pw,mh,8);x.fill();x.fillStyle='#f4f5f6';let fs=Math.max(22,Math.round(mh*.16));x.font='700 '+fs+'px Arial';x.fillText(place.value,px+Math.round(mw*.035),py+fs+Math.round(mh*.05));x.font=Math.max(12,Math.round(fs*.58))+'px Arial';const max=pw-Math.round(pw*.03);let al=address.value;while(x.measureText(al).width>max&&al.length>10)al=al.slice(0,-4)+'…';x.fillText(al,px+Math.round(mw*.035),py+fs+Math.round(mh*.16));x.font=Math.max(12,Math.round(fs*.62))+'px Arial';x.fillText('Lat '+(+lat.value).toFixed(5)+'°',px+Math.round(mw*.035),py+fs+Math.round(mh*.29));x.fillText('Long '+(+lng.value).toFixed(5)+'°',px+Math.round(mw*.035),py+fs+Math.round(mh*.41));x.fillText(stampText(),px+Math.round(mw*.035),py+fs+Math.round(mh*.53));
if(logoImage&&logoImage.complete&&logoImage.naturalWidth){const lw=Math.min(220,Math.max(120,Math.round(w*.20))),lh=Math.round(lw*40/220);x.drawImage(logoImage,w-margin-lw,h-margin-lh,lw,lh)}
const raw=c.toDataURL('image/jpeg',.95);let out=raw;try{const d=new Date(date.value||Date.now()),p=n=>String(n).padStart(2,'0');const dms=v=>{const a=Math.abs(v),g=Math.floor(a),m=Math.floor((a-g)*60),s=Math.round((((a-g)*60)-m)*60*100);return [[g,1],[m,1],[s,100]]};const ex={'0th':{'270':place.value+' | '+address.value},'GPS':{'1':+lat.value>=0?'N':'S','2':dms(+lat.value),'3':+lng.value>=0?'E':'W','4':dms(+lng.value)},'Exif':{'36867':d.getFullYear()+':'+p(d.getMonth()+1)+':'+p(d.getDate())+' '+p(d.getHours())+':'+p(d.getMinutes())+':'+p(d.getSeconds())}};out=piexif.insert(piexif.dump(ex),raw)}catch(e){}$('download').disabled=false;$('download').onclick=()=>{const a=document.createElement('a');a.href=out;a.download='gps-map-camera.jpg';a.click()};const preview=URL.createObjectURL(dataUrlToBlob(out));$('photoPreview').src=preview;$('photoPreview').hidden=false;$('video').hidden=true}
function dataUrlToBlob(u){const [h,b]=u.split(',');const bin=atob(b);const arr=new Uint8Array(bin.length);for(let i=0;i<bin.length;i++)arr[i]=bin.charCodeAt(i);return new Blob([arr],{type:'image/jpeg'})}
async function drawMap(c,x,y,w,h){const im=new Image();im.crossOrigin='anonymous';im.src=lastMapUrl||'';await new Promise(r=>{im.onload=r;im.onerror=r});if(im.complete&&im.naturalWidth)c.drawImage(im,x,y,w,h);else{c.fillStyle='#4b5948';c.fillRect(x,y,w,h)}c.save();c.translate(x+w/2,y+h/2);c.rotate(-Math.PI/4);c.fillStyle='#e8332e';c.beginPath();c.arc(0,0,Math.max(8,w*.055),0,Math.PI*2);c.fill();c.restore()}
function round(c,x,y,w,h,r){c.beginPath();c.moveTo(x+r,y);c.arcTo(x+w,y,x+w,y+h,r);c.arcTo(x+w,y+h,x,y+h,r);c.arcTo(x,y+h,x,y,r);c.arcTo(x,y,x+w,y,r);c.closePath()}
refreshMap();renderStamp();startGPS();
</script>
</body>
</html>
